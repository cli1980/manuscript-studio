{
  "id": "manuscript-formatting-v1",
  "title": "Manuscript formatting (DOCX)",
  "workflow": "format-manuscript",
  "engine": "workflow.src.formatting:FormattingEngine",
  "consumes": "accepted-markdown-chapters/1",
  "target_format": "docx",
  "hands_off": true,
  "document_backend": {
    "builder": "python-docx",
    "renderer": "platform-default",
    "require_visual_review": true
  },
  "agents": {
    "format": {
      "skill": "format-manuscript",
      "skills": ["format-manuscript", "prepare-manuscript", "review-approval-sheet", "documents"],
      "model": null
    }
  },
  "gates": {
    "format_spec": {"sheet": "required", "binding": "required", "closure": "required"},
    "question": {}
  },
  "stages": [
    {"id": "format", "kind": "agent", "agent": "format", "gates": ["format_spec", "question"],
     "owns": ["manuscript-formatting/"]}
  ]
}
