{
  "id": "literary-translation-v1",
  "title": "Literary translation",
  "workflow": "literary-translation",
  "engine": "workflow.src.translation:TranslationEngine",
  "prepared_input": true,
  "target_language": "en-US",
  "locked_metadata": ["/manuscript_language"],
  "passage_size": {"cjk_chars": 1500, "words": 800},
  "agents": {
    "translate": {
      "skill": "literary-translation",
      "skills": ["prepare-manuscript", "manuscript-analysis", "literary-translation", "review-approval-sheet"],
      "model": null
    }
  },
  "library": {
    "checkout": [],
    "areas": ["literary-translation/"]
  },
  "gates": {
    "map_exceptions": {"sheet": "required", "binding": "required", "closure": "implied"},
    "translation_issue": {"sheet": "required", "binding": "required", "closure": "implied"},
    "chapter_sanity": {"sheet": "optional", "binding": "required", "closure": "required", "item_binding": true},
    "translation_consistency": {"sheet": "optional", "binding": "required", "closure": "required", "item_binding": true,
                                "empty_command": "confirm consistency"},
    "brief_samples": {"sheet": "required", "binding": "required", "closure": "implied"},
    "translation_brief": {"documents": ["translation/glossary.md", "translation/voice.md", "translation/brief-samples.md"],
                          "command": "approve brief"},
    "continuation": {},
    "question": {}
  },
  "stages": [
    {"id": "brief", "kind": "agent", "agent": "translate", "front_matter": true,
     "gates": ["brief_samples", "translation_brief", "question"]},
    {"id": "translate", "kind": "agent", "agent": "translate", "iterate": "chapters",
     "gates": ["map_exceptions", "translation_issue", "chapter_sanity", "continuation", "question", "translation_consistency"],
     "owns": ["translation/"],
     "iteration": {
       "owns": ["translation/.literary-translation-work/{work_id}/{chapter_id}/"],
       "carry_forward": ["translation/glossary.md", "translation/voice.md", "translation/brief-samples.md"],
       "restartable": true,
       "conclude": true
     }},
    {"id": "accept", "kind": "acceptance"},
    {"id": "export", "kind": "export"}
  ],
  "produces": "accepted-markdown-chapters/1"
}
