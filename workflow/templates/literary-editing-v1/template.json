{
  "id": "literary-editing-v1",
  "title": "Literary editing",
  "workflow": "literary-editing",
  "engine": "workflow.src.editing:EditingEngine",
  "locked_metadata": ["/manuscript_language"],
  "agents": {
    "prepare": {
      "skill": "prepare-manuscript",
      "skills": ["prepare-manuscript"],
      "model": null
    },
    "interior-design": {
      "skill": "interior-design",
      "skills": ["prepare-manuscript", "interior-design"],
      "model": null
    },
    "developmental": {
      "skill": "literary-editing",
      "skills": ["prepare-manuscript", "literary-editing", "review-approval-sheet"],
      "model": null
    },
    "line": {
      "skill": "literary-editing",
      "skills": ["prepare-manuscript", "literary-editing", "review-approval-sheet"],
      "model": null
    },
    "copy": {
      "skill": "literary-editing",
      "skills": ["prepare-manuscript", "literary-editing", "review-approval-sheet"],
      "model": null
    }
  },
  "library": {
    "checkout": [],
    "areas": ["literary-editing/"]
  },
  "gates": {
    "editorial_review": {"sheet": "optional", "binding": "required", "closure": "implied",
                         "empty_command": "approve review", "empty_evidence": "No changes proposed"},
    "apply_authorization": {"binding": "required", "command": "apply accepted changes"},
    "question": {}
  },
  "stages": [
    {"id": "prepare", "kind": "agent", "agent": "prepare", "preparation": true, "gates": ["question"],
     "owns": ["prepared/", "source/", "manuscript/", "editorial/"]},
    {"id": "metadata", "kind": "metadata_review"},
    {"id": "passes", "kind": "select", "options": [
      {"stage": "developmental", "title": "Developmental edit",
       "description": "Structure, character, pacing, and theme across the whole book: a verdict and recommendations for later passes. The text does not change."},
      {"stage": "line", "title": "Line edit",
       "description": "Sentence-level clarity, rhythm, voice, and paragraphing, chapter by chapter, then a whole-book consistency pass. You approve every change."},
      {"stage": "copy", "title": "Copy edit",
       "description": "Grammar, usage, punctuation, spelling, factual consistency, and house style, chapter by chapter, then a whole-book consistency pass. You approve every change."}
    ]},
    {"id": "developmental", "kind": "agent", "agent": "developmental", "edits_text": false,
     "iterate": "chapters", "gates": ["editorial_review", "question"],
     "owns": ["editorial/passes/{pass}/"],
     "iteration": {
       "owns": ["editorial/passes/{pass}/{chapter_id}/"],
       "carry_forward": ["editorial/editorial-brief.md", "editorial/style-sheet.md", "editorial/continuity-concordance.md"],
       "restartable": true,
       "conclude": true
     }},
    {"id": "line", "kind": "agent", "agent": "line", "iterate": "chapters",
     "gates": ["editorial_review", "apply_authorization", "question"],
     "owns": ["editorial/passes/{pass}/"],
     "iteration": {
       "owns": ["editorial/passes/{pass}/{chapter_id}/"],
       "carry_forward": ["editorial/editorial-brief.md", "editorial/style-sheet.md", "editorial/continuity-concordance.md"],
       "restartable": true,
       "conclude": true
     }},
    {"id": "copy", "kind": "agent", "agent": "copy", "iterate": "chapters",
     "gates": ["editorial_review", "apply_authorization", "question"],
     "owns": ["editorial/passes/{pass}/"],
     "iteration": {
       "owns": ["editorial/passes/{pass}/{chapter_id}/"],
       "carry_forward": ["editorial/editorial-brief.md", "editorial/style-sheet.md", "editorial/continuity-concordance.md"],
       "restartable": true,
       "conclude": true
     }},
    {"id": "approve-manuscript", "kind": "acceptance"},
    {"id": "interior-design", "kind": "agent", "agent": "interior-design", "gates": ["question"],
     "owns": ["interior-design/"]},
    {"id": "accept", "kind": "acceptance"},
    {"id": "export", "kind": "export"}
  ],
  "produces": "accepted-markdown-chapters/1"
}
