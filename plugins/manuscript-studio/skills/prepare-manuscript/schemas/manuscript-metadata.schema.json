{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:manuscript-studio:metadata:1",
  "title": "Shared manuscript metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "subtitle", "contributors", "original_language", "manuscript_language", "work_type", "form", "genres", "audience", "keywords", "description", "edition", "series", "extent"],
  "properties": {
    "title": {"$ref": "#/$defs/text"},
    "subtitle": {"$ref": "#/$defs/text"},
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "roles"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "roles": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["author", "translator", "editor", "illustrator", "contributor"]}
          }
        }
      }
    },
    "original_language": {"$ref": "#/$defs/language"},
    "manuscript_language": {"$ref": "#/$defs/language"},
    "work_type": {"enum": [null, "fiction", "memoir", "nonfiction", "poetry", "drama", "mixed"]},
    "form": {"enum": [null, "novel", "novella", "short_story", "collection", "essay", "poem", "play", "screenplay", "book", "mixed", "other"]},
    "genres": {"$ref": "#/$defs/terms"},
    "audience": {"enum": [null, "adult", "young_adult", "middle_grade", "children", "general", "academic", "professional"]},
    "keywords": {"$ref": "#/$defs/terms"},
    "description": {"$ref": "#/$defs/text"},
    "edition": {
      "type": "object", "additionalProperties": false, "required": ["label", "status"],
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "status": {"enum": [null, "draft", "complete_draft", "revised", "final"]}
      }
    },
    "series": {
      "type": "object", "additionalProperties": false, "required": ["name", "position", "relationship"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "position": {"type": ["number", "null"], "minimum": 0},
        "relationship": {"enum": [null, "standalone", "series_potential", "part_of_series"]}
      }
    },
    "extent": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["word_count", "non_whitespace_character_count", "unit_count", "method", "basis_revision", "scope"],
          "properties": {
            "word_count": {"type": ["integer", "null"], "minimum": 0},
            "non_whitespace_character_count": {"type": ["integer", "null"], "minimum": 0},
            "unit_count": {"type": ["integer", "null"], "minimum": 0},
            "method": {"type": "string", "minLength": 1},
            "basis_revision": {"type": "string", "pattern": "^r[0-9]{4,}$"},
            "scope": {
              "type": "object", "additionalProperties": false, "required": ["kind", "chapter_ids"],
              "properties": {
                "kind": {"enum": ["whole_work", "selected_chapters"]},
                "chapter_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "text": {"type": ["string", "null"], "minLength": 1},
    "language": {"type": ["string", "null"], "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
    "terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "field": {
      "enum": ["/title", "/subtitle", "/contributors", "/original_language", "/manuscript_language", "/work_type", "/form", "/genres", "/audience", "/keywords", "/description", "/edition/label", "/edition/status", "/series/name", "/series/position", "/series/relationship", "/extent"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chapter_id", "locator", "quote"],
        "properties": {
          "chapter_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/field"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["origin", "review_status", "confidence", "basis_revision", "evidence", "rationale", "value_sha256", "updated_at", "updated_by"],
        "properties": {
          "origin": {"enum": ["provided", "extracted", "inferred", "computed", "user_edit", "legacy"]},
          "review_status": {"enum": ["proposed", "confirmed", "unreviewed", "stale"]},
          "confidence": {"enum": [null, "low", "medium", "high"]},
          "basis_revision": {"type": ["string", "null"], "pattern": "^r[0-9]{4,}$"},
          "evidence": {"$ref": "#/$defs/evidence"},
          "rationale": {"type": "string", "minLength": 1},
          "value_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "updated_at": {"type": "string", "format": "date-time"},
          "updated_by": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
