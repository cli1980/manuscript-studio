{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:manuscript-studio:prepare-manuscript:work:2",
  "title": "Prepared manuscript work record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_id", "record_revision", "updated_at", "metadata", "discovery", "preparation", "workflows"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "work_id": {"$ref": "#/$defs/id"},
    "record_revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "metadata": {},
    "metadata_provenance": {"$ref": "urn:manuscript-studio:metadata:1#/$defs/provenance"},
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_kind", "location", "recursive", "selection_status", "notes"],
      "properties": {
        "location_kind": {"enum": ["file", "directory", "attachment", "connected-storage"]},
        "location": {"type": "string", "minLength": 1},
        "recursive": {"type": "boolean"},
        "selection_status": {"enum": ["unresolved", "confirmed"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "current_revision", "blockers"],
      "properties": {
        "status": {"enum": ["not_started", "in_progress", "blocked", "ready", "stale"]},
        "current_revision": {"anyOf": [{"$ref": "#/$defs/revision"}, {"type": "null"}]},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["literary-editing", "literary-translation", "literary-agent-querying", "format-manuscript"],
      "properties": {
        "literary-editing": {"$ref": "#/$defs/workflow"},
        "literary-translation": {"$ref": "#/$defs/workflow"},
        "literary-agent-querying": {"$ref": "#/$defs/workflow"},
        "format-manuscript": {"$ref": "#/$defs/workflow"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {"properties": {"metadata": {"$ref": "#/$defs/legacyMetadata"}}, "not": {"required": ["metadata_provenance"]}},
      "else": {
        "required": ["metadata_provenance"],
        "properties": {"metadata": {"$ref": "urn:manuscript-studio:metadata:1"}}
      }
    }
  ],
  "$defs": {
    "legacyMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "authors", "source_language", "work_type", "genre", "edition"],
      "properties": {
        "title": {"$ref": "#/$defs/optionalText"},
        "authors": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "source_language": {"type": ["string", "null"], "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
        "work_type": {"enum": [null, "fiction", "memoir", "nonfiction", "poetry", "drama", "mixed"]},
        "genre": {"$ref": "#/$defs/optionalText"},
        "edition": {"$ref": "#/$defs/optionalText"}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 100},
    "revision": {"type": "string", "pattern": "^r[0-9]{4,}$"},
    "optionalText": {"type": ["string", "null"], "minLength": 1},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "chapter_ids"],
      "properties": {
        "kind": {"enum": ["whole_work", "selected_chapters"]},
        "chapter_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basis_revision", "scope", "operation", "state_locator", "updated_at"],
      "properties": {
        "status": {"enum": ["not_started", "in_progress", "awaiting_approval", "blocked", "completed", "stale"]},
        "basis_revision": {"anyOf": [{"$ref": "#/$defs/revision"}, {"type": "null"}]},
        "scope": {"anyOf": [{"$ref": "#/$defs/scope"}, {"type": "null"}]},
        "operation": {"$ref": "#/$defs/optionalText"},
        "state_locator": {"$ref": "#/$defs/optionalText"},
        "updated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator", "format", "identity"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "locator": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["sha256", "provider_version"]},
            "value": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "sha256"}}},
              "then": {"properties": {"value": {"$ref": "#/$defs/hash"}}}
            }
          ]
        }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_id", "order", "source_number", "title", "role", "file", "sha256", "source_spans", "status"],
      "properties": {
        "chapter_id": {"$ref": "#/$defs/id"},
        "order": {"type": "integer", "minimum": 1, "maximum": 9999},
        "source_number": {"$ref": "#/$defs/optionalText"},
        "title": {"$ref": "#/$defs/optionalText"},
        "role": {"enum": ["chapter", "front_matter", "back_matter", "standalone"]},
        "file": {"type": "string", "pattern": "^chapters/[0-9]{4}\\.md$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "source_spans": {"type": "array", "items": {"$ref": "#/$defs/sourceSpan"}, "minItems": 1},
        "status": {"enum": ["verified", "needs_review", "incomplete"]}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "media_type", "sha256", "source_id", "source_locator"],
      "properties": {
        "file": {"type": "string", "pattern": "^assets/[^\\\\]+$"},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "source_id": {"$ref": "#/$defs/id"},
        "source_locator": {"type": "string", "minLength": 1}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "description", "source_locator"],
      "properties": {
        "severity": {"enum": ["warning", "blocking"]},
        "description": {"type": "string", "minLength": 1},
        "source_locator": {"$ref": "#/$defs/optionalText"}
      }
    },
    "revisionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "work_id", "revision", "status", "created_at", "sources", "scope", "chapters", "assets", "extraction", "verification"],
      "properties": {
        "schema_version": {"const": 1},
        "work_id": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/revision"},
        "status": {"enum": ["extracted", "verified", "blocked"]},
        "created_at": {"type": "string", "format": "date-time"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1},
        "scope": {"$ref": "#/$defs/scope"},
        "chapters": {"type": "array", "items": {"$ref": "#/$defs/chapter"}, "minItems": 1},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "method", "normalization_notes"],
          "properties": {
            "tool": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1},
            "normalization_notes": {"type": "array", "items": {"type": "string"}}
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["performed_by", "verified_at", "coverage_complete", "issues"],
          "properties": {
            "performed_by": {"$ref": "#/$defs/optionalText"},
            "verified_at": {"type": ["string", "null"], "format": "date-time"},
            "coverage_complete": {"type": "boolean"},
            "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
          }
        }
      }
    }
  }
}
