        "paragraph_sequence_sha256": "398175eef1fb70a773a501d514bf4f6af06abad4360dc0c262e31430ab16d427"
      },
      "characters_excluding_heading_and_whitespace": 4067,
      "opening_anchor": "十四、米娅",
      "closing_anchor": "离开阿瓦隆时，陆一鸣发现外界正值破晓。茫茫晨霭笼罩海面，东方泛起一片异红。"
    },
    {
      "unit_id": "body-unit-15",
      "title": "十五、陷阱",
      "source_number": "十五",
      "role": "chapter",
      "section_kind": "numbered_chapter",
