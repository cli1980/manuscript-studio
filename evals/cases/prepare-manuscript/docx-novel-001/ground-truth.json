        "paragraph_sequence_sha256": "95c0b3e4d4ae468cc833841e0ebbda0115784a92362a08035b277a5f79c02dba"
      },
      "characters_excluding_heading_and_whitespace": 5210,
      "opening_anchor": "十一、重逢",
      "closing_anchor": "“浮城阿瓦隆。”米娅的声音低沉而潮湿，显然还没来得及收起心中的悲伤。"
    },
    {
      "unit_id": "body-unit-12",
      "title": "十二、浮城",
      "source_number": "十二",
      "role": "chapter",
      "section_kind": "numbered_chapter",
      "start_paragraph": 1261,
      "end_paragraph": 1351,
      "statistics": {
        "nonempty_paragraphs": 63,
        "characters_excluding_whitespace": 4226,
        "text_sha256_excluding_whitespace": "d0c24c74357f20b8620026d66edc775c0e3d770b0946805242137d75a88d818c",
        "paragraph_sequence_sha256": "90da620b078f39de135759efff8ee385e711e91a37fa6ef4c217c0c2e4152774"
      },
      "characters_excluding_heading_and_whitespace": 4221,
      "opening_anchor": "十二、浮城",
      "closing_anchor": "这一突如其来的涟漪完全出乎陆一鸣的意料。他在这个异世界里好不容易攒起来的从容瞬间松动、垮塌，慌乱不声不响地浮上心头。"
    },
    {
      "unit_id": "body-unit-13",
      "title": "十三、祭司",
      "source_number": "十三",
      "role": "chapter",
      "section_kind": "numbered_chapter",
      "start_paragraph": 1352,
      "end_paragraph": 1425,
      "statistics": {
        "nonempty_paragraphs": 64,
        "characters_excluding_whitespace": 4926,
        "text_sha256_excluding_whitespace": "8656f28a7d447c7822ecece9cdc000971b3686ed6e84eaaae648bf42b826cc6e",
        "paragraph_sequence_sha256": "2f046a8c44dca5f41e671d1805ee7ae285c517b9e86b70b9fac136feb03491f7"
      },
      "characters_excluding_heading_and_whitespace": 4921,
      "opening_anchor": "十三、祭司",
      "closing_anchor": "女的时候，我就狂热地崇拜他，这没什么大不了；在那些本来就阴冷无比的日子里，谁又能拒绝那种像太阳一样耀眼而炽热的光芒呢？”"
    },
    {
      "unit_id": "body-unit-14",
      "title": "十四、米娅",
      "source_number": "十四",
      "role": "chapter",
      "section_kind": "numbered_chapter",
      "start_paragraph": 1426,
      "end_paragraph": 1494,
      "statistics": {
